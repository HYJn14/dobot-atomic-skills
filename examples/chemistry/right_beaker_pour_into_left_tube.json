    "beaker_at": "right.beaker.approach_zone",
    "tube_at": "left.tube.approach_zone",
    "beaker_contents": "water",
    "tube_contents": "empty",
    "left_gripper": "open (must be prepared first)",
    "right_gripper": "open (must be prepared first)"
  },
