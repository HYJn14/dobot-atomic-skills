{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dobot dobot-dag/1 supported RuntimeExecutionPackage 2.1 shapes",
  "description": "Local supported profile, not the partner's official full schema. Runtime also checks dependencies, calibrated bindings, resource ordering, object lifecycle and idempotency.",
  "type": "object",
  "required": ["schema_version", "graph_version", "package_id", "experiment_id", "nodes", "edges"],
  "properties": {
    "schema_version": {"const": "2.1"},
    "graph_version": {"const": "0.1"},
    "package_id": {"$ref": "#/$defs/id"},
    "experiment_id": {"$ref": "#/$defs/id"},
    "catalog_revision": {"description": "Optional opaque caller metadata, preserved and included in the package fingerprint; not compared with the gateway catalog."},
    "entry_node_id": {"$ref": "#/$defs/id"},
    "entry_node_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "nodes": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"oneOf": [{"$ref": "#/$defs/action"}, {"$ref": "#/$defs/wait"}]}},
    "edges": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/edge"}}
  },
  "anyOf": [{"required": ["entry_node_id"]}, {"required": ["entry_node_ids"]}],
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S"},
    "node": {
      "type": "object", "required": ["node_id", "node_type", "status"],
      "properties": {
        "node_id": {"$ref": "#/$defs/id"},
        "status": {"const": "pending"},
        "timeout_s": {"type": "number", "minimum": 0.01, "maximum": 900},
        "preconditions": {"const": []}, "abort_conditions": {"const": []},
        "recovery_policy": {"enum": [null, "stop_and_preserve_evidence", "decision_agent"]},
        "on_fail": {
          "type": "object",
          "properties": {
            "strategy": {"enum": ["safe_stop", "decision_agent"]},
            "max_retries": {"type": "integer", "minimum": 0, "maximum": 10},
            "allowed_actions": {"type": "array", "items": {"enum": ["retry", "resume_from", "revise_graph", "human_confirmation", "safe_stop"]}}
          }
        }
      }
    },
    "action": {
      "allOf": [
        {"$ref": "#/$defs/node"},
        {"required": ["skill_invocation"], "properties": {
          "node_type": {"const": "action"},
          "completion_condition": {"const": "motion_sequence_completed"},
          "skill_invocation": {
            "type": "object", "required": ["skill_id", "skill_version", "device_id", "parameters", "idempotency_key"],
            "properties": {
              "skill_id": {"enum": ["embodied.pick", "embodied.place"]},
              "skill_version": {"const": "1.0.0"},
              "device_id": {"enum": ["dobot-nova-left", "dobot-nova-right"]},
              "idempotency_key": {"$ref": "#/$defs/id"},
              "parameters": {
                "type": "object", "required": ["object_id"],
                "properties": {
                  "object_id": {"enum": ["A", "B"]},
                  "source_ref": {"enum": ["object:A", "object:B", "target:target_A", "target:target_B"]},
                  "destination_ref": {"enum": ["object:A", "object:B", "target:target_A", "target:target_B"]}
                },
                "additionalProperties": false,
                "oneOf": [{"required": ["source_ref"], "not": {"required": ["destination_ref"]}}, {"required": ["destination_ref"], "not": {"required": ["source_ref"]}}]
              }
            },
            "allOf": [
              {"if": {"properties": {"skill_id": {"const": "embodied.pick"}}}, "then": {"properties": {"parameters": {"required": ["source_ref"]}}}},
              {"if": {"properties": {"skill_id": {"const": "embodied.place"}}}, "then": {"properties": {"parameters": {"required": ["destination_ref"]}}}}
            ]
          }
        }}
      ]
    },
    "wait": {
      "allOf": [
        {"$ref": "#/$defs/node"},
        {"required": ["duration_s"], "properties": {"node_type": {"const": "wait"}, "duration_s": {"type": "number", "minimum": 0, "maximum": 60}, "completion_condition": {"const": "wait_elapsed"}}, "not": {"required": ["skill_invocation"]}}
      ]
    },
    "edge": {
      "type": "object", "required": ["source", "target", "edge_type"],
      "properties": {"source": {"$ref": "#/$defs/id"}, "target": {"$ref": "#/$defs/id"}, "edge_type": {"const": "success"}},
      "additionalProperties": false
    }
  }
}
