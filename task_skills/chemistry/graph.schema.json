{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/task-skills/chemistry/graph-1.0.0.schema.json",
  "title": "Chemistry Atomic Action Graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "nodes"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "initial_facts": {"type": "object", "additionalProperties": true},
    "nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/node"}}
  },
  "$defs": {
    "nodeBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "skill", "arm", "parameters"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "skill": {"type": "string"},
        "version": {"const": "1.0.0", "default": "1.0.0"},
        "arm": {"enum": ["left", "right"]},
        "parameters": {"type": "object"},
        "depends_on": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true, "default": []}
      }
    },
    "moveJointParameters": {
      "type": "object", "additionalProperties": false, "required": ["target_ref"],
      "properties": {
        "target_ref": {"type": "string", "minLength": 1}, "source_ref": {"type": "string", "minLength": 1},
        "speed": {"type": "integer", "minimum": 1, "maximum": 100, "default": 20},
        "grip_requirement": {"enum": ["any", "open", "clamped"], "default": "any"},
        "tilt_limit_deg": {"type": "number", "minimum": 0, "maximum": 10, "default": 1}
      }
    },
    "moveLinearParameters": {
      "type": "object", "additionalProperties": false, "required": ["source_ref", "target_ref"],
      "properties": {
        "source_ref": {"type": "string", "minLength": 1}, "target_ref": {"type": "string", "minLength": 1},
        "speed": {"type": "integer", "minimum": 1, "maximum": 100, "default": 20},
        "grip_requirement": {"enum": ["any", "open", "clamped"], "default": "open"},
        "tilt_limit_deg": {"type": "number", "minimum": 0, "maximum": 10, "default": 1}
      }
    },
    "moveToHomeParameters": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "source_ref": {"type": "string", "minLength": 1},
        "speed": {"type": "integer", "minimum": 1, "maximum": 100, "default": 20}
      }
    },
    "gripperParameters": {
      "type": "object", "additionalProperties": false, "required": ["position"],
      "properties": {
        "position": {"type": "integer", "minimum": 0, "maximum": 255},
        "speed": {"type": "integer", "minimum": 1, "maximum": 100, "default": 10},
        "allow_release": {"type": "boolean", "default": false}, "at_ref": {"type": "string", "minLength": 1}
      }
    },
    "pivotParameters": {
      "type": "object", "additionalProperties": false, "required": ["source_ref"],
      "properties": {
        "source_ref": {"const": "right.beaker.work"},
        "tilt_deg": {"type": "number", "exclusiveMinimum": 0, "maximum": 90, "default": 80},
        "offset_mm": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3, "default_from": "profile.pour.offset_mm"},
        "segments": {"type": "integer", "minimum": 2, "maximum": 128, "default": 16},
        "speed": {"type": "integer", "minimum": 1, "maximum": 100, "default": 15},
        "cp": {"type": "integer", "minimum": 0, "maximum": 100, "default": 100}
      }
    },
    "holdParameters": {
      "type": "object", "additionalProperties": false, "required": ["seconds"],
      "properties": {"seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 600}}
    },
    "node": {
      "oneOf": [
        {"allOf": [{"$ref": "#/$defs/nodeBase"}, {"properties": {"skill": {"const": "arm.move_joint"}, "parameters": {"$ref": "#/$defs/moveJointParameters"}}}]},
        {"allOf": [{"$ref": "#/$defs/nodeBase"}, {"properties": {"skill": {"const": "arm.move_linear"}, "parameters": {"$ref": "#/$defs/moveLinearParameters"}}}]},
        {"allOf": [{"$ref": "#/$defs/nodeBase"}, {"properties": {"skill": {"const": "arm.move_to_home"}, "parameters": {"$ref": "#/$defs/moveToHomeParameters"}}}]},
        {"allOf": [{"$ref": "#/$defs/nodeBase"}, {"properties": {"skill": {"const": "gripper.set_position"}, "parameters": {"$ref": "#/$defs/gripperParameters"}}}]},
        {"allOf": [{"$ref": "#/$defs/nodeBase"}, {"properties": {"skill": {"const": "arm.rotate_about_pivot"}, "parameters": {"$ref": "#/$defs/pivotParameters"}}}]},
        {"allOf": [{"$ref": "#/$defs/nodeBase"}, {"properties": {"skill": {"const": "control.hold"}, "parameters": {"$ref": "#/$defs/holdParameters"}}}]}
      ]
    }
  }
}
